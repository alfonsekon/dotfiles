# luis rice

#######################
# VARIABLES & THEME   #
#######################
set $mod Mod4

# Color schemes for windows 
set $bgcolor    #1d2021
set $in-bgcolor #303030
set $text       #fec925
set $dark-text  #dea900
set $pink       #cb9592
set $u-bgcolor  #ff5555
set $indicator  #a8a3c1
set $in-text    #969696

# Define names for default workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $ws11 "11"
set $ws12 "12"

#######################
# VISUALS & BORDERS   #
#######################
font pango:JetBrains Mono 8

# remove title bar
for_window [class=".*"] border pixel 4

# gaps
gaps inner 4
gaps outer 4
smart_borders on

# Window Colors
#                       border          background      text            indicator
client.focused          $pink           $pink           $bgcolor        $indicator
client.unfocused        $in-bgcolor     $in-bgcolor     $in-text        $in-bgcolor
client.focused_inactive $in-bgcolor     $in-bgcolor     $in-text        $in-bgcolor
client.urgent           $u-bgcolor      $u-bgcolor      $text           $u-bgcolor 

#######################
# KEYBINDS - GENERAL  #
#######################
# kill focused window
bindsym $mod+Shift+q kill

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace
bindsym $mod+Shift+r restart
# exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# container layouts
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
floating_modifier Mod1
focus_wrapping no

##########################
# KEYBINDS - WORKSPACES  #
##########################
# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10
bindsym $mod+minus workspace number $ws11
bindsym $mod+equal workspace number $ws12
bindsym $mod+y exec bash -c 'i3-msg workspace "$(rofi -dmenu -p "goto workspace" -theme "$HOME/.config/rofi/launchers/type-1/style-3.rasi" )"'

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10
bindsym $mod+Shift+minus move container to workspace number $ws11
bindsym $mod+Shift+equal move container to workspace number $ws12
bindsym $mod+Shift+y exec bash -c 'i3-msg move container to workspace "$(rofi -dmenu -p "move window to workspace" -theme "$HOME/.config/rofi/launchers/type-1/style-3.rasi" )"'

##########################
# KEYBINDS - APPLICATIONS#
##########################
# start terminals
bindsym $mod+Return exec wezterm --config-file /home/luis/.dotfiles/wezterm/.config/wezterm/wezterm.lua &
bindsym $mod+Shift+Return exec wezterm --config-file /home/luis/.wezterm.lua & 

# Rofi launchers
bindsym $mod+d exec --no-startup-id /home/luis/.config/rofi/launchers/type-3/launcher.sh
bindsym Mod1+Tab exec --no-startup-id rofi -show window -theme ~/.config/rofi/launchers/type-3/style-10.rasi
bindsym $mod+x exec --no-startup-id /home/luis/.config/rofi/powermenu/type-3/powermenu.sh

# Apps
bindsym $mod+p exec pavucontrol
bindsym $mod+Shift+p exec blueman-manager
bindsym $mod+n exec nemo
bindsym $mod+c exec codium
bindsym $mod+b exec vivaldi-stable
bindsym $mod+Shift+b exec vivaldi-stable --incognito
bindsym $mod+o exec screenkey &
bindsym $mod+shift+o exec pkill screenkey

# Clipboard history (greenclip)
bindsym $mod+v exec --no-startup-id sh -c 'greenclip print | rofi -dmenu -i -p "Clipboard" -theme "$HOME/.config/rofi/launchers/type-3/style-10.rasi" | xclip -selection clipboard'
bindsym $mod+Shift+v exec --no-startup-id greenclip clear
bindsym $mod+Ctrl+v exec --no-startup-id greenclip daemon

##########################
# KEYBINDS - HARDWARE    #
##########################
# Audio controls
set $refresh_i3status killall -SIGUSR1 i3status
set $refresh_i3blocks pkill -RTMIN+1 i3blocks
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3blocks
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3blocks
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3blocks
bindsym $mod+Up exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $refresh_i3blocks
bindsym $mod+Down exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $refresh_i3blocks
bindsym $mod+Shift+Down exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3blocks

# Brightness controls
bindsym $mod+Shift+Left exec brightnessctl set 1600-
bindsym $mod+Shift+Right exec brightnessctl set +1600
bindsym $mod+Left exec bash -c '[ $(brightnessctl g) -gt 1600 ] && brightnessctl set 1600-'
bindsym $mod+Right exec brightnessctl set +1600

# Screenshots
bindsym Print exec --no-startup-id bash -c '~/personal/scripts/fs_fullsave.sh'
bindsym Shift+Print exec --no-startup-id bash -c '~/personal/scripts/fs_cropsave.sh'
bindsym Insert exec --no-startup-id bash -c '~/personal/scripts/fs_fullclip.sh'
bindsym Shift+Insert exec --no-startup-id bash -c '~/personal/scripts/fs_cropclip.sh'
bindsym Mod4+Shift+s exec --no-startup-id bash -c '~/personal/scripts/fs_ss.sh'

#######################
# MODES               #
#######################
bindsym $mod+r mode "resize"

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

#######################
# WINDOW RULES        #
#######################
for_window [class="Vivaldi-stable"] move to workspace 1, layout tabbed
for_window [class="wezterm"] move to workspace 2, layout tabbed
for_window [class="VSCodium"] move to workspace 3, layout tabbed
for_window [class="Code"] move to workspace 3, layout tabbed
for_window [class="Arduino*"] move to workspace 3, layout tabbed
for_window [class="jetbrains-studio"] move to workspace 3, layout tabbed
for_window [class="Nemo"] move to workspace 4, layout tabbed
for_window [class="Wihotspot"] move to workspace 8, layout tabbed
for_window [class="Pavucontrol"] move to workspace 8, layout tabbed
for_window [class="Blueman-manager"] move to workspace 8, layout tabbed

#######################
# BAR CONFIGURATION   #
#######################
bindsym $mod+Shift+m bar mode toggle

bar {
        status_command i3blocks -c /home/$USER/.config/i3blocks/i3blocks.conf
     	padding 2px 6px 4px 1px
		font pango:JetBrains Mono 9
		position top
        colors {
                background $bgcolor
                separator #999999
                #                       border          background      text
                focused_workspace       $pink           $pink           $bgcolor
                inactive_workspace      $bgcolor        $bgcolor        $pink
                urgent_workspace        $u-bgcolor      $u-bgcolor      #eeeeee
        }
}

#######################
# AUTOSTART           #
#######################
exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet
exec --no-startup-id flameshot &
exec --no-startup-id wezterm --config-file /home/luis/.dotfiles/wezterm/.config/wezterm/wezterm.lua &
exec --no-startup-id bash -c "~/dotfiles/picom-12.5/build/src/picom > /dev/null 2>&1 &"
exec --no-startup-id greenclip daemon
exec --no-startup-id libinput-gestures-setup restart > /dev/null
exec_always --no-startup-id feh --bg-scale ~/Pictures/wallpapers/martin-martz-Sjp4w1dYpoc-unsplash.jpg
exec_always --no-startup-id bash -c 'echo eval "$(/home/luis/.local/bin/oh-my-posh init bash --config ~/.config/oh-my-posh/luis.omp.json)" > ~/.cache/omp_theme'
exec_always --no-startup-id ~/personal/scripts/pointers.sh
