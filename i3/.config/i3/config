# brightness controls
bindsym $mod+Shift+Left exec brightnessctl set 1600-
bindsym $mod+Shift+Right exec brightnessctl set +1600
bindsym $mod+Left exec bash -c '[ $(brightnessctl g) -gt 1600 ] && brightnessctl set 1600-'
bindsym $mod+Right exec brightnessctl set +1600

bindsym $mod+r mode "resize"

focus_wrapping no

#remove title bar
for_window [class=".*"] border pixel 4

# gaps
gaps inner 4
gaps outer 4
smart_borders on

# hide status bar
bindsym $mod+Shift+m bar mode toggle

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
        status_command i3blocks -c /home/$USER/.config/i3blocks/i3blocks.conf
     	padding 2px 6px 4px 1px
		font pango:JetBrains Mono 9
		position top
        colors {
                background $bgcolor
                separator #999999
                #                       border          background      text
                focused_workspace       $pink           $pink           $bgcolor
                inactive_workspace      $bgcolor        $bgcolor        $pink
                urgent_workspace        $u-bgcolor      $u-bgcolor      #eeeeee

        }
}

